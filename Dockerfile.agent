ARG AGENT_VERSION=dev

FROM golang:1.26.6-alpine3.23@sha256:e57c41c1d5864341031181b0db34b9a537bb5773eb6428e4e5bdaea0f9135406 AS build
ARG AGENT_VERSION
ARG SOURCE_KIND
ARG SOURCE_COMMIT
WORKDIR /src
COPY . .
RUN printf '%s\n' "${AGENT_VERSION}" | grep -Eq '^(dev|(agent/)?v?[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?)$' \
    && if [ -n "$SOURCE_KIND$SOURCE_COMMIT" ]; then \
        printf '%s\n' "$SOURCE_KIND" | grep -Eq '^(source_ref|release)$' \
        && printf '%s\n' "$SOURCE_COMMIT" | grep -Eq '^[0-9a-f]{40}$'; fi \
    && CGO_ENABLED=0 GOOS=linux GOAMD64=v1 GOARM64=v8.0 GOMAXPROCS=2 go build -p=2 -trimpath -buildvcs=false \
        -ldflags="-s -w -buildid= -X github.com/AlanD20/groundplane/internal/common/version.Value=${AGENT_VERSION} -X github.com/AlanD20/groundplane/internal/common/version.SourceKind=${SOURCE_KIND} -X github.com/AlanD20/groundplane/internal/common/version.SourceCommit=${SOURCE_COMMIT}" \
        -o /out/groundplane-agent ./cmd/agent

FROM docker/compose-bin:v2.40.3@sha256:e39da8206cc48c6e2c99ce371935eef9d7eff7db600a993fd357de8b75621edf AS compose
FROM docker:29.1.3-cli@sha256:4fa0ee1f3a7e4354c4ea34558b6d4ee32859baf4973d4c8ccc8e7fe3dd730c04 AS dockercli

FROM scratch
ARG AGENT_VERSION
ARG SOURCE_KIND
ARG SOURCE_COMMIT
ENV DOCKER_COMPOSE_VERSION=2.40.3 \
    DOCKER_HOST=unix:///var/run/docker.sock \
    HOME=/root \
    PATH=/usr/local/bin:/usr/bin:/bin \
    TMPDIR=/tmp
LABEL org.opencontainers.image.source="https://github.com/AlanD20/groundplane" \
      org.opencontainers.image.title="Groundplane Agent" \
      org.opencontainers.image.version="${AGENT_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      com.groundplane.source-kind="${SOURCE_KIND}"
COPY --from=dockercli /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=compose /docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=build /out/groundplane-agent /usr/local/bin/groundplane-agent
USER 0:0
WORKDIR /root
WORKDIR /tmp
WORKDIR /
ENTRYPOINT ["/usr/local/bin/groundplane-agent"]
CMD []
