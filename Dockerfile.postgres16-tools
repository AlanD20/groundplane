ARG POSTGRES16_BASE
FROM ${POSTGRES16_BASE} AS postgres

FROM golang:1.26.6-alpine3.23@sha256:e57c41c1d5864341031181b0db34b9a537bb5773eb6428e4e5bdaea0f9135406 AS toolchain

FROM postgres AS build
ARG BUILDARCH
ARG TARGETARCH
RUN test "$BUILDARCH" = "$TARGETARCH" \
    && case "$TARGETARCH" in amd64|arm64) ;; *) exit 1 ;; esac \
    && apk add --no-cache build-base linux-headers openssl-dev patchelf lddtree
COPY --from=toolchain /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH \
    CGO_ENABLED=0 GOMAXPROCS=2 GOTOOLCHAIN=go1.26.7 \
    GOAMD64=v1 GOARM64=v8.0
WORKDIR /src
COPY . .
RUN set -eu; mkdir -p /out/opt/groundplane/postgres16/bin /out/opt/groundplane/postgres16/lib \
    && cc -std=c11 -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 \
        -fstack-protector-strong -fPIE -pie \
        -o /out/opt/groundplane/postgres16/client-gate cmd/postgres16-gate/main.c -lcrypto \
    && cp /usr/local/bin/pg_dump /usr/local/bin/pg_restore /usr/local/bin/psql /out/opt/groundplane/postgres16/bin/ \
    && for executable in /out/opt/groundplane/postgres16/client-gate /out/opt/groundplane/postgres16/bin/*; do \
         lddtree -l "$executable" > /out/libraries \
         && tail -n +2 /out/libraries | while read -r library; do \
           cp -L "$library" "/out/opt/groundplane/postgres16/lib/$(basename "$library")"; \
         done; \
       done \
    && interpreter=$(basename /out/opt/groundplane/postgres16/lib/ld-musl-*.so.1) \
    && test -n "$interpreter" \
    && for executable in /out/opt/groundplane/postgres16/client-gate /out/opt/groundplane/postgres16/bin/*; do \
         patchelf --set-interpreter "/opt/groundplane/postgres16/lib/$interpreter" \
           --set-rpath /opt/groundplane/postgres16/lib "$executable"; \
       done \
    && for library in /out/opt/groundplane/postgres16/lib/*; do \
         case "$(basename "$library")" in ld-musl-*) ;; *) patchelf --set-rpath /opt/groundplane/postgres16/lib "$library" ;; esac; \
       done \
    && chmod 0500 /out/opt/groundplane/postgres16/client-gate \
    && gate_sha=$(sha256sum /out/opt/groundplane/postgres16/client-gate | cut -d ' ' -f 1) \
    && dump_sha=$(sha256sum /out/opt/groundplane/postgres16/bin/pg_dump | cut -d ' ' -f 1) \
    && restore_sha=$(sha256sum /out/opt/groundplane/postgres16/bin/pg_restore | cut -d ' ' -f 1) \
    && psql_sha=$(sha256sum /out/opt/groundplane/postgres16/bin/psql | cut -d ' ' -f 1) \
    && go build -p=2 -trimpath -buildvcs=false \
        -ldflags="-s -w -buildid= -X github.com/AlanD20/groundplane/internal/postgres16helper.releaseGateSHA256=$gate_sha -X github.com/AlanD20/groundplane/internal/postgres16helper.releasePGDumpSHA256=$dump_sha -X github.com/AlanD20/groundplane/internal/postgres16helper.releasePGRestoreSHA256=$restore_sha -X github.com/AlanD20/groundplane/internal/postgres16helper.releasePSQLSHA256=$psql_sha" \
        -o /out/opt/groundplane/postgres16/helper ./cmd/postgres16-helper \
    && chmod 0555 /out/opt/groundplane/postgres16/helper \
    && go run -p=2 ./internal/postgres16releasemeta -root /out \
        -output /out/opt/groundplane/postgres16/release.json \
    && cd /out/opt/groundplane/postgres16 \
    && sha256sum bin/* lib/* client-gate helper release.json > SHA256SUMS

FROM scratch
COPY --from=build /out/opt/ /opt/
LABEL org.opencontainers.image.source="https://github.com/AlanD20/groundplane" \
      org.opencontainers.image.title="Groundplane PostgreSQL 16 backup tools"
