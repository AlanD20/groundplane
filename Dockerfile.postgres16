ARG POSTGRES16_BASE
FROM ${POSTGRES16_BASE} AS postgres

FROM golang:1.26.6-alpine3.23@sha256:e57c41c1d5864341031181b0db34b9a537bb5773eb6428e4e5bdaea0f9135406 AS toolchain

FROM postgres AS build
ARG BUILDARCH
ARG TARGETARCH
RUN test "$BUILDARCH" = "$TARGETARCH" \
    && case "$TARGETARCH" in amd64|arm64) ;; *) exit 1 ;; esac \
    && apk add --no-cache build-base linux-headers openssl-dev
COPY --from=toolchain /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH \
    CGO_ENABLED=0 GOMAXPROCS=2 GOTOOLCHAIN=go1.26.7 \
    GOAMD64=v1 GOARM64=v8.0
WORKDIR /src
COPY . .
RUN mkdir -p /out/usr/local/libexec /out/usr/local/bin /out/usr/local/share/groundplane \
    && cc -std=c11 -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 \
        -fstack-protector-strong -fPIE -pie \
        -o /out/usr/local/libexec/groundplane-postgres16-client-gate cmd/postgres16-gate/main.c -lcrypto \
    && chmod 0500 /out/usr/local/libexec/groundplane-postgres16-client-gate \
    && cp /usr/local/bin/pg_dump /usr/local/bin/pg_restore /usr/local/bin/psql /out/usr/local/bin/ \
    && gate_sha=$(sha256sum /out/usr/local/libexec/groundplane-postgres16-client-gate | cut -d ' ' -f 1) \
    && dump_sha=$(sha256sum /usr/local/bin/pg_dump | cut -d ' ' -f 1) \
    && restore_sha=$(sha256sum /usr/local/bin/pg_restore | cut -d ' ' -f 1) \
    && psql_sha=$(sha256sum /usr/local/bin/psql | cut -d ' ' -f 1) \
    && go build -p=2 -trimpath -buildvcs=false \
        -ldflags="-s -w -buildid= -X github.com/AlanD20/groundplane/internal/postgres16helper.releaseGateSHA256=$gate_sha -X github.com/AlanD20/groundplane/internal/postgres16helper.releasePGDumpSHA256=$dump_sha -X github.com/AlanD20/groundplane/internal/postgres16helper.releasePGRestoreSHA256=$restore_sha -X github.com/AlanD20/groundplane/internal/postgres16helper.releasePSQLSHA256=$psql_sha" \
        -o /out/usr/local/libexec/groundplane-postgres16-helper ./cmd/postgres16-helper \
    && chmod 0555 /out/usr/local/libexec/groundplane-postgres16-helper \
    && go run -p=2 ./internal/postgres16releasemeta -root /out \
        -output /out/usr/local/share/groundplane/postgres16-release.json

FROM postgres
RUN apk add --no-cache libcrypto3 \
    && case "$(postgres --version)" in "postgres (PostgreSQL) 16."*) ;; *) exit 1 ;; esac \
    && test "$(id -u postgres)" = 70 && test "$(id -g postgres)" = 70 \
    && install -d -o 0 -g 0 -m 0755 /usr/local/libexec /usr/local/share/groundplane \
    && install -d -o 0 -g 0 -m 0700 /run/groundplane-postgres16
COPY --from=build /out/usr/local/libexec/ /usr/local/libexec/
COPY --from=build /out/usr/local/share/groundplane/ /usr/local/share/groundplane/
LABEL org.opencontainers.image.source="https://github.com/AlanD20/groundplane" \
      org.opencontainers.image.title="Groundplane managed PostgreSQL 16"
