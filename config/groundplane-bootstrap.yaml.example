# The one hand-run bootstrap compose file — brings up the Agent, which
# then applies everything else the Controller renders (including
# groundplane-infra: CoreDNS + the Agent itself). See mvp.md, "Core
# (locked) — the groundplane-infra component".
#
#   systemctl start groundplane-agent
#   docker compose -f /etc/groundplane/groundplane-bootstrap.yaml up -d
name: groundplane-bootstrap
services:
  agent:
    image: ghcr.io/sample-tenant/groundplane-agent:latest
    restart: unless-stopped
    network_mode: host
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /etc/groundplane:/etc/groundplane:ro
      - /var/log/groundplane:/var/log/groundplane
