# /etc/groundplane/agent.yaml — the bootstrap SEED only. Runtime config
# (pull interval, max concurrent tasks, labels) is Controller-owned in
# etcd; `groundplane agent config set` writes there, never here.
controller:
  address: 127.0.0.1:8081   # Controller gRPC address the Agent dials out to
join_token_path: /etc/groundplane/agent.token
log:
  level: warn
  console:
    enabled: true
  file:
    enabled: true
    path: /var/log/groundplane/agent.log
