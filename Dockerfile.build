FROM node:24.19.0-bookworm-slim AS node
FROM golang:1.26.7-bookworm AS build
COPY --from=node /usr/local/ /usr/local/
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global npm@11.17.0
WORKDIR /src
COPY . .
ARG VERSION
ARG SOURCE_KIND
ARG SOURCE_COMMIT
ARG POSTGRES16_RELEASE_BASE64
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOFLAGS="-p=2 -trimpath" GOAMD64=v1 GOARM64=v8.0
RUN if [ -n "$SOURCE_KIND$SOURCE_COMMIT" ]; then \
        printf '%s\n' "$SOURCE_KIND" | grep -Eq '^(source_ref|release)$' \
        && printf '%s\n' "$SOURCE_COMMIT" | grep -Eq '^[0-9a-f]{40}$'; fi \
    && bash scripts/repo-env.sh npm --prefix console ci \
    && bash scripts/repo-env.sh npm --prefix console run build \
    && make console-toolchain controller-binary cli VERSION="$VERSION" \
        SOURCE_KIND="$SOURCE_KIND" SOURCE_COMMIT="$SOURCE_COMMIT" \
        POSTGRES16_RELEASE_BASE64="$POSTGRES16_RELEASE_BASE64"
FROM scratch AS controller-payload
COPY --from=build /src/bin/controller /controller
COPY --from=build /src/bin/controller-release.json /controller-release.json
COPY --from=build /src/bin/groundplane /groundplane
COPY --from=build /src/openapi.json /openapi.json

FROM build AS source-checked
RUN bash scripts/repo-env.sh go run ./internal/openapigen -output .tmp/source-openapi.json \
    && cmp openapi.json .tmp/source-openapi.json \
    && cp console/src/lib/api.generated.ts .tmp/source-api.generated.ts \
    && bash scripts/repo-env.sh npm --prefix console run generate:api \
    && cmp console/src/lib/api.generated.ts .tmp/source-api.generated.ts

FROM controller-payload AS source-payload
COPY --from=source-checked /src/console/dist /console-dist

FROM controller-payload
